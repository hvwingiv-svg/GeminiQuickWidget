<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_outside_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Coordinate-locked floating container positioned right over the widget's screen bounds -->
    <LinearLayout
        android:id="@+id/floating_anchor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 1. FLOATING '+' MENU (Full Gemini App Attachment, Model & Aesthetic Menu) -->
        <LinearLayout
            android:id="@+id/floating_plus_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_response_card"
            android:elevation="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <!-- Top Row: Full Gemini App Attachment Actions (Camera, Gallery, Files, Drive) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="4">

                <LinearLayout
                    android:id="@+id/menu_btn_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_circle_button_shadow"
                        android:elevation="6dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_video_cam" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Camera"
                        android:textColor="#E3E3E3"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_btn_gallery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_circle_button_shadow"
                        android:elevation="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🖼️"
                            android:textSize="17sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Gallery"
                        android:textColor="#E3E3E3"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_btn_files"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_circle_button_shadow"
                        android:elevation="6dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_share_up" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Files"
                        android:textColor="#E3E3E3"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_btn_drive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_circle_button_shadow"
                        android:elevation="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="☁️"
                            android:textSize="17sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Drive"
                        android:textColor="#E3E3E3"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Second Row: Model Switcher & Aesthetic Selector (Solid / Frosted / 3D Liquid Glass) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_model_selector"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gemini_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="✦ 2.5 Flash ▾"
                    android:textColor="#A8C7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_style_selector"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_gemini_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="◈ 3D Liquid Glass"
                    android:textColor="#E3E3E3"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_api_key_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_gemini_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🔑 Key"
                    android:textColor="#C4C7C5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Collapsible API Key Row inside '+' Menu -->
            <LinearLayout
                android:id="@+id/api_key_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/input_api_key"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gemini_pill"
                    android:hint="Paste Gemini API Key (AIza...)"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E918F"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_save_key"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:text="Save"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. FLOATING MULTI-TURN CHAT & RESPONSE WINDOW -->
        <LinearLayout
            android:id="@+id/overlay_response_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_response_card"
            android:elevation="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_status_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✦ Gemini 2.5 Flash"
                    android:textColor="#A8C7FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_new_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="New"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_tts_speak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="🔊"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_copy_response"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="Copy"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_close_response"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxHeight="240dp">

                <TextView
                    android:id="@+id/overlay_response_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#F1F3F4"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </ScrollView>
        </LinearLayout>

        <!-- 3. ATTACHMENT PREVIEW CHIP ROW -->
        <LinearLayout
            android:id="@+id/attachment_chip_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_gemini_pill"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/attachment_chip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📎 Image attached"
                android:textColor="#A8C7FA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/attachment_chip_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="✕"
                android:textColor="#E3E3E3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. FLOATING PILL BAR (With 3D Liquid Glass & Multi-Layer Drop Shadows) -->
        <LinearLayout
            android:id="@+id/floating_pill_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_gemini_pill"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/overlay_btn_plus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Toggle plus menu"
                android:padding="6dp"
                android:src="@drawable/ic_plus" />

            <EditText
                android:id="@+id/overlay_edit_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/whats_next"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="textCapSentences"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/overlay_btn_mic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Voice input"
                android:padding="6dp"
                android:src="@drawable/ic_mic" />

            <FrameLayout
                android:id="@+id/overlay_btn_send_or_live"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_live_circle"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/overlay_right_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send" />
            </FrameLayout>
        </LinearLayout>

        <!-- 5. GEMINI LIVE 5-BUTTON DOCK (Exact Match to Screenshot_20261102_041232_Google) -->
        <LinearLayout
            android:id="@+id/floating_live_dock"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Button 1: Video / Camera Context Circle -->
            <FrameLayout
                android:id="@+id/live_btn_video"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_button_shadow"
                android:elevation="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Live Camera Feed"
                    android:src="@drawable/ic_video_cam" />
            </FrameLayout>

            <!-- Button 2: Screen / Image Share Context Circle -->
            <FrameLayout
                android:id="@+id/live_btn_share"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_circle_button_shadow"
                android:elevation="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Share Screen or Image"
                    android:src="@drawable/ic_share_up" />
            </FrameLayout>

            <!-- Center 3: Animated Glowing Blue-White Aurora Pill -->
            <com.custom.geminiquickwidget.AuroraVisualizerView
                android:id="@+id/live_aurora_visualizer"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:elevation="14dp" />

            <!-- Button 4: Microphone Mute / Speak Circle -->
            <FrameLayout
                android:id="@+id/live_btn_mic"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_button_shadow"
                android:elevation="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Microphone Toggle"
                    android:src="@drawable/ic_mic" />
            </FrameLayout>

            <!-- Button 5: Close 'X' Circle -->
            <FrameLayout
                android:id="@+id/live_btn_close"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_circle_button_shadow"
                android:elevation="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="End Gemini Live"
                    android:src="@drawable/ic_close_x" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
