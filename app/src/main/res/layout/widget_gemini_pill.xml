<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_outer_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- MODE A: Clean Scalable Floating Gemini Pill with Drop Shadows -->
    <LinearLayout
        android:id="@+id/widget_pill_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_gemini_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Left '+' Button: Opens Floating Full Gemini '+' Menu -->
        <ImageView
            android:id="@+id/widget_btn_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Open attachment and tools menu"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus" />

        <!-- Center Prompt Trigger -->
        <TextView
            android:id="@+id/widget_btn_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/whats_next"
            android:textColor="#D6D8DA"
            android:textSize="17sp" />

        <!-- Right Microphone Button -->
        <ImageView
            android:id="@+id/widget_btn_mic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Voice input"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <!-- Far-Right Floating Live Button with Drop Shadow -->
        <FrameLayout
            android:id="@+id/widget_btn_live"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_live_circle"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/widget_right_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Gemini Live"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_waveform" />
        </FrameLayout>
    </LinearLayout>

    <!-- MODE B: In-Place Gemini Live 5-Element Dock (Exact Screenshot Layout) -->
    <LinearLayout
        android:id="@+id/widget_live_dock_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="2dp"
        android:visibility="gone">

        <!-- 1. Left Video / Camera Circle Button -->
        <FrameLayout
            android:id="@+id/widget_live_btn_video"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_button_shadow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Live Camera"
                android:src="@drawable/ic_video_cam" />
        </FrameLayout>

        <!-- 2. Screen / Image Context Share Circle Button -->
        <FrameLayout
            android:id="@+id/widget_live_btn_share"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_button_shadow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Share Screen or Image"
                android:src="@drawable/ic_share_up" />
        </FrameLayout>

        <!-- 3. Center Glowing Blue-White Aurora Pill -->
        <FrameLayout
            android:id="@+id/widget_live_aurora_pill"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_live_aurora_pill" />

        <!-- 4. Microphone / Mute Circle Button -->
        <FrameLayout
            android:id="@+id/widget_live_btn_mic"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_button_shadow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Mute or Speak"
                android:src="@drawable/ic_mic" />
        </FrameLayout>

        <!-- 5. Right Close 'X' Circle Button -->
        <FrameLayout
            android:id="@+id/widget_live_btn_close"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_button_shadow">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="End Gemini Live"
                android:src="@drawable/ic_close_x" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
