<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#3B82F6" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
</layer-list>
