<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient drop shadow -->
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#55000000" />
        </shape>
    </item>
    <!-- Key drop shadow -->
    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#77000000" />
        </shape>
    </item>
    <!-- Dark circular button matching Gemini Live screenshot -->
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#242629" />
            <stroke
                android:width="1dp"
                android:color="#29FFFFFF" />
        </shape>
    </item>
</layer-list>
