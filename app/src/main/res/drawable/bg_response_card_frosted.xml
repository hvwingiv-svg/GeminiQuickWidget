<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#A61A1C22"
                android:endColor="#B8282C36"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.2dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
