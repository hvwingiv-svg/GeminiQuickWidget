<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E1F22" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#383A3E" />
        </shape>
    </item>
</layer-list>
